<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aula 30 - Banco de Dados - exemplos JDBC (Oracle e PostgreSQL)
  Prof. Giovane Barcelos

  Este pom serve apenas para BAIXAR os drivers JDBC (Tipo 4, "thin") para a
  pasta target/dependency. Os exemplos sao arquivos unicos, executados direto
  pelo Java 11+ (sem javac):

    mvn -q dependency:copy-dependencies
    java -cp "target/dependency/*" BD3001-ConexaoOracle.java
    java -cp "target/dependency/*" BD3002-ConexaoPostgres.java
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.edu.bd</groupId>
  <artifactId>bd-class30-jdbc</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- Driver JDBC do Oracle (ojdbc11 = Java 11+) -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>23.26.0.0.0</version>
    </dependency>
    <!-- Driver JDBC do PostgreSQL (pgJDBC) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.8</version>
    </dependency>
  </dependencies>
</project>
